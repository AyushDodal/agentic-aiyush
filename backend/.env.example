# An existing environment variable takes precedence over this file.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# auto: OpenAI when configured, otherwise local extractive search.
AI_MODE=auto
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Paths are relative to backend/ unless absolute.
DATA_DIR=data
# Embedded/local mode only. Leave unset for cloud deployments.
RESUME_PATH=
# Read-only resume asset used by /api/resume in cloud mode.
RESUME_DOWNLOAD_PATH=resume/resume.pdf
# Leave empty for embedded Qdrant. Cloud stores both vectors and index metadata.
QDRANT_URL=
QDRANT_API_KEY=
# Share rate limits across serverless instances using a Redis TLS connection URL.
# Leave empty for local in-memory limits; configure shared limits before public release.
RATE_LIMIT_STORAGE_URI=
CHAT_RATE_LIMIT=12/minute
AUDIO_RATE_LIMIT=6/minute
