# An existing environment variable takes precedence over this file.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# auto: OpenAI when configured, otherwise local extractive search.
AI_MODE=auto
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Paths are relative to backend/ unless absolute.
DATA_DIR=data
# Optionally ingest on startup; otherwise use python -m app.ingest.
RESUME_PATH=
# Leave empty for embedded Qdrant. Use Qdrant Cloud for multiple replicas.
QDRANT_URL=
QDRANT_API_KEY=
CHAT_RATE_LIMIT=12/minute
AUDIO_RATE_LIMIT=6/minute
